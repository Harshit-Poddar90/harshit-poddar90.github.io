# Copy to .env and fill in. .env is gitignored.

# Google AI Studio key, used for both embeddings and generation.
GOOGLE_API_KEY=your-key-here

# Origins allowed to call /chat. Comma-separated, no trailing slashes.
# Leave unset in development to use the built-in defaults.
ALLOWED_ORIGINS=https://harshit-poddar90.github.io,http://localhost:8000

# Where the Chroma index lives. Only change if you move the directory.
# CHROMA_PATH=./portfolio_db

# Gemini chat model. Google retires ids regularly — when /health reports a
# 404 NOT_FOUND, set this to the replacement id Google names in the error,
# no code change or redeploy needed.
# CHAT_MODEL=gemini-3.6-flash
